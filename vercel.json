{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist-single",
  "installCommand": "npm install --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    {
      "source": "/saas",
      "destination": "/api/saas"
    },
    {
      "source": "/saas/:d",
      "destination": "/api/saas?d=:d"
    },
    {
      "source": "/sitemap-saas.xml",
      "destination": "/api/saas?sitemap=1"
    },
    {
      "source": "/a/:app",
      "destination": "/api/article?app=:app"
    },
    {
      "source": "/a/:app/:a",
      "destination": "/api/article?app=:app&a=:a"
    },
    {
      "source": "/blog",
      "destination": "/api/article"
    },
    {
      "source": "/blog/:a",
      "destination": "/api/article?a=:a"
    }
  ]
}
