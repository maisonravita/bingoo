{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist-single",
  "installCommand": "npm install --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    {
      "source": "/saas",
      "destination": "/api/saas"
    },
    {
      "source": "/saas/:d",
      "destination": "/api/saas?d=:d"
    },
    {
      "source": "/sitemap-saas.xml",
      "destination": "/api/saas?sitemap=1"
    }
  ]
}