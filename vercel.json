{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist-single",
  "installCommand": "npm install --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://fbsjbnnmzazylmquzryo.supabase.co/functions/v1/t/mcp"
    },
    {
      "source": "/mcp/:cle",
      "destination": "https://fbsjbnnmzazylmquzryo.supabase.co/functions/v1/t/mcp/:cle"
    },
    {
      "source": "/p/:app",
      "destination": "/api/app?app=:app"
    },
    {
      "source": "/s/:app",
      "destination": "/api/site?slug=:app"
    },
    {
      "source": "/sitemap-apps.xml",
      "destination": "/api/app?sitemap=1"
    },
    {
      "source": "/saas",
      "destination": "/api/saas"
    },
    {
      "source": "/saas/:d",
      "destination": "/api/saas?d=:d"
    },
    {
      "source": "/sitemap-saas.xml",
      "destination": "/api/saas?sitemap=1"
    },
    {
      "source": "/a/:app",
      "destination": "/api/article?app=:app"
    },
    {
      "source": "/a/:app/:a",
      "destination": "/api/article?app=:app&a=:a"
    },
    {
      "source": "/blog",
      "destination": "/api/article"
    },
    {
      "source": "/blog/:a",
      "destination": "/api/article?a=:a"
    },
    {
      "source": "/abonnement",
      "destination": "/index.html"
    },
    {
      "source": "/abonnement/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/aide",
      "destination": "/index.html"
    },
    {
      "source": "/aide/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/equipe",
      "destination": "/index.html"
    },
    {
      "source": "/equipe/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/explorer",
      "destination": "/index.html"
    },
    {
      "source": "/explorer/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/reglages",
      "destination": "/index.html"
    },
    {
      "source": "/reglages/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "api/_polices/**"
    }
  }
}
