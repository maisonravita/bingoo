{
  "manifest_version": 3,
  "name": "Bingoo!",
  "version": "1.2.0",
  "description": "Bingoo! sur chaque site d'entreprise (signaux, contacts, ajout en un clic) et pilote LinkedIn : invitations et premier message, avec des quotas prudents.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bingoo!"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fbsjbnnmzazylmquzryo.supabase.co/*",
    "https://www.linkedin.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://kairo.maisonravita.fr/*"
    ]
  }
}